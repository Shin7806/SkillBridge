# Your Supabase project (Project Settings -> API). The publishable key is safe in the browser;
# never put a service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# End-to-end test accounts go in .env.test (git-ignored). See docs/testing.md.
